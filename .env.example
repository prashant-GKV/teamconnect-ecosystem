# ============================================================
# TeamConnect — Environment Variables
# Copy this file to .env and fill in values for local dev.
# NEVER commit .env to version control.
# ============================================================

# --- Backend ---
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/teamconnect

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_TTL=900           # 15 minutes in seconds
JWT_REFRESH_TTL=604800       # 7 days in seconds

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tc-submissions
MINIO_USE_SSL=false
SIGNED_URL_TTL=3600          # 1 hour in seconds

# SMTP (optional — leave blank to log-only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@teamconnect.local

# Rate limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# Worker
WORKER_EXPIRY_CRON=0 * * * *         # every hour
WORKER_REMINDER_DAYS=7               # warn 7 days before expiry
WORKER_OVERDUE_CRON=0 6 * * *        # daily 06:00

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
USE_MOCKS=true                       # set false to hit real backend

# --- Admin ---
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4000/api/v1
