{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@teamconnect/shared-types":  ["../packages/shared-types/src"],
      "@teamconnect/validation":    ["../packages/validation/src"],
      "@teamconnect/shared-config": ["../packages/shared-config/src"]
    }
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
